NODE_ENV=development

# WhatsApp
WHATSAPP_CLIENT_ID=il-salone-sender

# Excel
EXCEL_PATH=./base_de_datos_clientes.xlsx

# Campaign
CAMPAIGN_IMAGE_PATH=./assets/il-salone-sorteo.png

# Safety Controls
ENABLE_BULK_SEND=false
TEST_MODE=true

# Test Contact
TEST_PHONE=573024585004
TEST_NAME=Odalis

# Limits
MAX_MESSAGES_PER_RUN=50

# Delays (milliseconds)
MIN_DELAY_BETWEEN_MESSAGES_MS=5000
MAX_DELAY_BETWEEN_MESSAGES_MS=10000
TEST_SEND_DELAY_MS=3000
DELAY_BETWEEN_TEXT_AND_IMAGE_MS=5000

# Send Mode: MEDIA_WITH_CAPTION | TEXT_THEN_IMAGE
SEND_MODE=MEDIA_WITH_CAPTION

# Retries
MAX_RETRIES=2
